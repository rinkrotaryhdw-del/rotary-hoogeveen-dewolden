---
import Basis from '../layouts/Basis.astro';
---

<Basis titel="Pagina niet gevonden">
  <section class="sectie">
    <div class="container smal">
      <span class="bovenkop">Foutmelding 404</span>
      <h1>Deze pagina bestaat niet (meer)</h1>
      <p class="inleiding">Misschien is de pagina verplaatst. Probeer het via de homepage of het nieuwsarchief.</p>
      <p>
        <a class="knop" href="/">Naar de homepage</a>
        <a class="knop knop--rand" href="/nieuws/archief">Nieuwsarchief</a>
      </p>
    </div>
  </section>
</Basis>
