---
import Basis from '../layouts/Basis.astro';
import NieuwsKaart from '../components/NieuwsKaart.astro';
import EditieUitgelicht from '../components/EditieUitgelicht.astro';
import SocialBlok from '../components/SocialBlok.astro';
import instellingen from '../data/instellingen.json';
import bestuur from '../data/bestuur.json';
import { getNieuws, getEdities, huidigeEditie, alineas } from '../lib/utils';

const nieuws = (await getNieuws()).slice(0, 3);
const editie = huidigeEditie(await getEdities());
---

<Basis>
  <section class="held">
    <div class="container">
      {
        instellingen.logo ? (
          <img class="held__logo" src={instellingen.logo} alt={instellingen.clubnaam} />
        ) : (
          <span class="bovenkop">{instellingen.clubnaam}</span>
        )
      }
      <h1>{instellingen.home_titel}</h1>
      <hr class="goudlijn" />
      <div class="held__tekst">
        {alineas(instellingen.home_intro).map((a) => <p>{a}</p>)}
      </div>
      <div class="held__knoppen">
        <a class="knop" href="/contact">Kom kennismaken</a>
      </div>
    </div>
  </section>

  {
    editie && (
      <section class="sectie">
        <div class="container">
          <EditieUitgelicht editie={editie} />
        </div>
      </section>
    )
  }

  {
    instellingen.geschiedenis_tekst && (
      <section class="sectie geschiedenis" aria-labelledby="geschiedenis-kop">
        <div class="container geschiedenis__raster">
          <p class="geschiedenis__jaar" aria-hidden="true">
            <span>Sinds</span> {bestuur.opgericht?.match(/\d{4}/)?.[0] ?? '1980'}
          </p>
          <div>
            <span class="bovenkop">Over de club</span>
            <h2 id="geschiedenis-kop">{instellingen.geschiedenis_titel || 'Onze geschiedenis'}</h2>
            <div class="geschiedenis__tekst">
              {alineas(instellingen.geschiedenis_tekst).map((a) => <p>{a}</p>)}
            </div>
            <a href="/bestuur">Maak kennis met het bestuur</a>
          </div>
        </div>
      </section>
    )
  }

  <section class="sectie sectie--wit">
    <div class="container">
      <div class="sectiekop">
        <div>
          <span class="bovenkop">Actueel</span>
          <h2>Laatste nieuws</h2>
        </div>
        <a href="/nieuws">Alle berichten</a>
      </div>
      {
        nieuws.length ? (
          <div class="kaarten">
            {nieuws.map((bericht) => <NieuwsKaart bericht={bericht} />)}
          </div>
        ) : (
          <p>Er zijn nog geen nieuwsberichten.</p>
        )
      }
    </div>
  </section>

  <section class="sectie">
    <div class="container">
      <SocialBlok />
    </div>
  </section>
</Basis>

<style>
  .held {
    padding: 5rem 0 4rem;
    background:
      radial-gradient(ellipse at 85% 0%, rgb(247 168 27 / 0.2), transparent 55%),
      linear-gradient(180deg, var(--goud-zacht) 0%, var(--creme) 100%);
    border-bottom: 1px solid var(--lijn);
  }

  .held__logo {
    width: min(100%, 22rem);
    height: auto;
    margin-bottom: 2rem;
  }

  .held h1 {
    max-width: 20ch;
  }

  .held__tekst {
    max-width: var(--tekst-max);
    font-size: 1.15rem;
    color: var(--inkt-zacht);
  }

  .held__knoppen {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .geschiedenis {
    border-top: 1px solid var(--lijn);
  }

  .geschiedenis__raster {
    display: grid;
    gap: 1rem 3rem;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
  }

  @media (min-width: 48rem) {
    .geschiedenis__raster {
      grid-template-columns: 14rem minmax(0, 1fr);
    }
  }

  .geschiedenis__jaar {
    margin: 0;
    font-size: clamp(3.5rem, 9vw, 5.5rem);
    font-weight: 700;
    line-height: 1;
    color: var(--blauw);
    border-left: 6px solid var(--goud);
    padding-left: 1.25rem;
  }

  .geschiedenis__jaar span {
    display: block;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--inkt-zacht);
    margin-bottom: 0.4rem;
  }

  .geschiedenis h2 {
    margin-top: 0.25rem;
  }

  .geschiedenis__tekst {
    max-width: var(--tekst-max);
    color: var(--inkt-zacht);
  }

  .geschiedenis a {
    font-weight: 600;
  }

  .sectiekop {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .sectiekop h2 {
    margin: 0;
  }

  .sectiekop a {
    font-weight: 600;
  }
</style>
